# Cloudflare Configuration
# Get these from your Cloudflare dashboard

# D1 Database ID (from: wrangler d1 create flight_data)
D1_DATABASE_ID=YOUR_D1_DATABASE_ID_HERE

# Vectorize Index Name (from: wrangler vectorize create user-preferences-index)
VECTORIZE_INDEX_NAME=user-preferences-index

# Flight API Keys
# Get Skyscanner API key from: https://rapidapi.com/skyscanner/api/skyscanner-flight-search
SKYSCANNER_API_KEY=your_skyscanner_api_key_here

# Get Amadeus credentials from: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Get Kiwi API key from: https://tequila.kiwi.com/portal/
KIWI_API_KEY=your_kiwi_api_key_here

# Cloudflare Account ID (optional, for some advanced features)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Environment (development/production)
NODE_ENV=development
