# Movie Recommendation System - Environment Variables
# Copy this to .env or .dev.vars and fill in your values

# ============================================
# TMDB API (Required)
# ============================================
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ============================================
# Authentication (Required for production)
# ============================================
# JWT secret for signing tokens (use a strong random string in production)
JWT_SECRET=change-this-to-a-secure-random-string

# ============================================
# Cloudflare Configuration (Optional)
# ============================================
# D1 Database ID (from: wrangler d1 create movie_data)
D1_DATABASE_ID=your_d1_database_id_here

# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# ============================================
# Development Settings
# ============================================
NODE_ENV=development
